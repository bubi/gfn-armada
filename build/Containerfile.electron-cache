FROM --platform=linux/arm64 node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
RUN node --input-type=module -e 'import {downloadArtifact} from "@electron/get"; import {createRequire} from "node:module"; const require=createRequire(import.meta.url); await downloadArtifact({version:require("./package.json").devDependencies.electron,artifactName:"electron",platform:"linux",arch:"arm64",checksums:require("electron/checksums.json")})'
