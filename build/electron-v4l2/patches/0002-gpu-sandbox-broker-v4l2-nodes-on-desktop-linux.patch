+// Desktop Linux: V4L2Device enumerates /dev/video0..255 and
+// /dev/media0..255 (see v4l2_device.cc), so those nodes must be brokered.
+void AddDesktopLinuxV4L2GpuPermissions(
+    std::vector<BrokerFilePermission>* permissions) {
+  static constexpr int kMaxV4L2Nodes = 256;
+  for (int i = 0; i < kMaxV4L2Nodes; ++i) {
+    permissions->push_back(BrokerFilePermission::ReadWrite(
+        base::StringPrintf("/dev/video%d", i)));
+    permissions->push_back(BrokerFilePermission::ReadWrite(
+        base::StringPrintf("/dev/media%d", i)));
+  }
+}
+
 std::vector<BrokerFilePermission> FilePermissionsForGpu(
     const sandbox::policy::SandboxSeccompBPF::Options& options) {
   // All GPU process policies need this file brokered out.
