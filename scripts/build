#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
engine="${CONTAINER_ENGINE:-docker}"
command -v "$engine" >/dev/null || { echo 'Install Docker or Podman with Linux ARM64 support' >&2; exit 1; }
"$engine" info >/dev/null || { echo "Container engine $engine is not running or not accessible; start its Linux ARM64 VM and retry." >&2; exit 1; }
if ! "$engine" image inspect gfn-armada-electron-cache:44.5.1 >/dev/null 2>&1; then
  "$engine" build --platform linux/arm64 -f build/Containerfile.electron-cache -t gfn-armada-electron-cache:44.5.1 .
fi
"$engine" build --platform linux/arm64 -f build/Containerfile -t gfn-armada-builder .
mkdir -p dist
# Export over the engine stream instead of copying hundreds of files through
# a macOS VM bind mount. Check container exit before extracting any output.
export_archive=$(mktemp "${TMPDIR:-/tmp}/gfn-armada-build.XXXXXX")
trap 'rm -f "$export_archive"' EXIT HUP INT TERM
"$engine" run --rm --platform linux/arm64 --user "$(id -u):$(id -g)" -e HOME=/tmp \
  gfn-armada-builder tar -cf - -C /work/dist gfn-armada-linux-arm64 > "$export_archive"
tar -xf "$export_archive" -C dist
