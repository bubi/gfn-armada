--- /dev/null
+++ b/test/bitreader-boundaries-test.cc
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+#include "../src/codec/bitwriter.h"
+#include <stdexcept>
+#include <iostream>
+#include <limits>
+static void check(bool value) { if (!value) throw std::runtime_error("BitReader boundary regression"); }
+int main() {
+    for (uint32_t value : {0u,1u,15u,255u,0x7fffffffu,0xfffffffeu}) {
+        BitWriter writer; writer.ue(value);
+        BitReader reader(writer.data().data(),writer.data().size(),0);
+        check(reader.ue()==value);
+    }
+    for (unsigned zeros : {32u,33u,40u,64u}) {
+        BitWriter writer;
+        for (unsigned i=0;i<zeros;++i) writer.bit(0);
+        writer.bit(1);
+        BitReader reader(writer.data().data(),writer.data().size(),0);
+        bool rejected=false;try { (void)reader.ue(); } catch (const std::runtime_error&) { rejected=true; }
+        check(rejected);
+    }
+    for (auto bytes : {std::vector<uint8_t>{},std::vector<uint8_t>{0,0,0,0}}) {
+        BitReader reader(bytes.data(),bytes.size(),0);
+        bool rejected=false;try { (void)reader.ue(); } catch (const std::runtime_error&) { rejected=true; }
+        check(rejected);
+    }
+    std::cout<<"BitReader UE: 31-zero boundary preserved; 32+ zero prefixes rejected before shift\n";
+}
