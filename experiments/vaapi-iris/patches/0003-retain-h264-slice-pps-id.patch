 bool has_start_code(const uint8_t* data, size_t size)
 {
     return size >= 3 && data[0] == 0 && data[1] == 0 && (data[2] == 1 || (size >= 4 && data[2] == 0 && data[3] == 1));
+}
+
+// The original slice header names its PPS; VA picture parameters omit that
+// identifier. Retain it in our generated PPS instead of rewriting slice bits.
+unsigned slice_pps_id(const uint8_t* data, size_t size)
+{
+    size_t offset = has_start_code(data, size) ? (data[2] == 1 ? 3 : 4) : 0;
+    require(offset < size && size - offset >= 2, "H.264 truncated slice header", VA_STATUS_ERROR_INVALID_PARAMETER);
+    const unsigned nal_type = data[offset] & 31u;
+    require(nal_type == 1 || nal_type == 5, "H.264 unsupported slice NAL", VA_STATUS_ERROR_INVALID_PARAMETER);
+    BitReader reader(data + offset, size - offset, 1);
+    reader.skip(8);
+    const auto read_ue = [&reader]() -> unsigned {
+        unsigned zeros = 0;
+        for (;;) {
+            require(!reader.exhausted(), "H.264 truncated Exp-Golomb", VA_STATUS_ERROR_INVALID_PARAMETER);
+            if (reader.bit()) break;
+            require(++zeros < 32, "H.264 oversized Exp-Golomb", VA_STATUS_ERROR_INVALID_PARAMETER);
+        }
+        require(reader.size_bits() - reader.position() >= zeros, "H.264 truncated Exp-Golomb suffix", VA_STATUS_ERROR_INVALID_PARAMETER);
+        return ((1u << zeros) - 1) + reader.bits(zeros);
+    };
+    read_ue(); // first_mb_in_slice
+    require(read_ue() <= 9, "H.264 invalid slice type", VA_STATUS_ERROR_INVALID_PARAMETER);
+    const unsigned id = read_ue();
+    require(id <= 255, "H.264 PPS identifier out of range", VA_STATUS_ERROR_INVALID_PARAMETER);
+    return id;
 }
 
