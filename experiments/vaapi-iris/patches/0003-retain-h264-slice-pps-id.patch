+// SPDX-License-Identifier: MIT
+#include "../src/codec/translator.h"
+#include "../src/codec/bitwriter.h"
+#include <stdexcept>
+#include <algorithm>
+#include <iostream>
+using namespace iris::codec;
+static void check(bool condition) { if (!condition) throw std::runtime_error("H264 PPS regression"); }
+static std::vector<uint8_t> slice(unsigned id) {
+    BitWriter w; w.ue(0); w.ue(2); w.ue(id); w.trailing_bits();
+    std::vector<uint8_t> bytes; append_escaped_nal(bytes, {0x65}, w); return bytes;
+}
+int main() {
+    VAPictureParameterBufferH264 params{};
+    params.picture_width_in_mbs_minus1=79; params.picture_height_in_mbs_minus1=44;
+    params.seq_fields.bits.frame_mbs_only_flag=1; params.seq_fields.bits.chroma_format_idc=1;
+    VASliceParameterBufferH264 sp{}; sp.slice_type=2;
+    Picture picture; picture.parameters=&params; picture.slice_parameters={&sp};
+    auto translator=make_h264(VAProfileH264High);
+    for (unsigned id : {0u,15u,255u}) {
+        auto original=slice(id); picture.slice_data={{original.data(),original.size()}};
+        AccessUnit au; translator->translate(picture,au);
+        check(au.sequence_start);
+        check(au.bytes.size()>=original.size());
+        check(std::equal(original.begin(),original.end(),au.bytes.end()-original.size()));
+        size_t at=0; bool found=false;
+        for (;at+5<au.bytes.size();++at) {
+            if (au.bytes[at]==0 && au.bytes[at+1]==0 && au.bytes[at+2]==0 && au.bytes[at+3]==1 && au.bytes[at+4]==0x68) {found=true;break;}
+        }
+        check(found); BitReader reader(au.bytes.data()+at+4,au.bytes.size()-at-4,1); reader.skip(8);
+        check(reader.ue()==id); check(reader.ue()==0);
+    }
+    for (auto malformed : {std::vector<uint8_t>{0x65},std::vector<uint8_t>{0x65,0},slice(256)}) {
+        picture.slice_data={{malformed.data(),malformed.size()}};
+        bool rejected=false; try { AccessUnit au; translator->translate(picture,au); } catch (const std::exception&) {rejected=true;}
+        check(rejected);
+    }
+    auto a=slice(0),b=slice(15); picture.slice_data={{a.data(),a.size()},{b.data(),b.size()}};
+    bool rejected=false;try {AccessUnit au;translator->translate(picture,au);}catch(const std::exception&){rejected=true;}
+    check(rejected);
+    std::cout<<"H264 PPS identifiers 0/15/255 retained; original slices unchanged; malformed/mixed IDs rejected\n";
+}
